{
  "name": "@infinite-canvas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:postgres": "tsx --test src/dispatcher.postgres.integration.test.ts",
    "recovery:audit": "tsx src/recovery-audit.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@hatchet-dev/typescript-sdk": "1.28.1",
    "@infinite-canvas/contracts": "0.1.0",
    "@infinite-canvas/db": "0.1.0",
    "@infinite-canvas/domain": "0.1.0",
    "@infinite-canvas/importer": "0.1.0",
    "@infinite-canvas/observability": "0.1.0",
    "@infinite-canvas/provider-adapters": "0.1.0",
    "@supabase/supabase-js": "2.99.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  }
}
