{
  "name": "@infinite-canvas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:postgres": "tsx --test src/generation.postgres.integration.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@infinite-canvas/contracts": "0.1.0",
    "@infinite-canvas/db": "0.1.0",
    "@infinite-canvas/domain": "0.1.0",
    "@infinite-canvas/importer": "0.1.0",
    "@infinite-canvas/observability": "0.1.0",
    "@supabase/supabase-js": "2.112.2",
    "fastify": "5.11.3",
    "fflate": "0.8.3",
    "jose": "6.2.8",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  }
}
