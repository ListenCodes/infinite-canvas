# Read-only isolated-restore audit. This process has no Hatchet or provider configuration.
BUSINESS_DATABASE_URL=postgresql://infinite_canvas_recovery_audit:replace-me@recovery-database-host:5432/postgres?sslmode=require
S3_REGION=auto
S3_ENDPOINT=https://replace-with-s3-compatible-endpoint.example.com
S3_BUCKET=infinite-canvas-assets
S3_ACCESS_KEY_ID=replace-with-read-only-object-storage-key
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
RECOVERY_AUDIT_INCLUDE_IDENTIFIERS=false
RECOVERY_AUDIT_OBJECT_CONCURRENCY=4
