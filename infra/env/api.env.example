NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
BUSINESS_DATABASE_URL=postgresql://infinite_canvas_api:replace-me@database-host:5432/postgres?sslmode=require
# Must be a direct or session-pool connection. Transaction poolers cannot carry LISTEN.
BUSINESS_DATABASE_LISTENER_URL=postgresql://infinite_canvas_api:replace-me@direct-database-host:5432/postgres?sslmode=require
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
STORAGE_BUCKET=infinite-canvas-assets
CORS_ALLOWED_ORIGINS=https://canvas.example.com
TRUST_PROXY=true
MAX_UPLOAD_BYTES=104857600
MAX_IMPORT_BYTES=26214400
MAX_CONCURRENT_IMPORTS=2
MAX_IMAGE_PIXELS=40000000
MAX_MEDIA_DURATION_SECONDS=1800
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
IDEMPOTENCY_TTL_SECONDS=86400
ADMIN_LARGE_DEBIT_THRESHOLD=1000
SSE_CURSOR_SCAN_MS=5000
