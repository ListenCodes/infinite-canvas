# This file is consumed only by one-shot migration/provision commands, never API or Worker.
BUSINESS_DATABASE_PROVISION_URL=postgresql://role-provisioner:replace-me@direct-database-host:5432/postgres?sslmode=require
BUSINESS_DATABASE_MIGRATION_URL=postgresql://migration-owner:replace-me@direct-database-host:5432/postgres?sslmode=require
BUSINESS_DATABASE_OBJECT_OWNER_ROLE=migration_owner
BUSINESS_DATABASE_API_ROLE=infinite_canvas_api
BUSINESS_DATABASE_API_PASSWORD=replace-with-at-least-20-random-characters
BUSINESS_DATABASE_WORKER_ROLE=infinite_canvas_worker
BUSINESS_DATABASE_WORKER_PASSWORD=replace-with-a-different-20-character-secret
BUSINESS_DATABASE_RECOVERY_AUDIT_PASSWORD=replace-with-a-third-20-character-secret
