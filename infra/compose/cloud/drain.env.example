WORKER_OLD_IMAGE=ghcr.io/listencodes/infinite-canvas-worker@sha256:replace-me
WORKER_NEW_IMAGE=ghcr.io/listencodes/infinite-canvas-worker@sha256:replace-me

# Prepared state: the old revision owns dispatch and reconciliation while the
# new revision starts, registers both workflow versions, and passes health checks.
WORKER_OLD_DISPATCHER_ENABLED=true
WORKER_NEW_DISPATCHER_ENABLED=false
WORKER_OLD_RECONCILER_ENABLED=true
WORKER_NEW_RECONCILER_ENABLED=false
