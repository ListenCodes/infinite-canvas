HATCHET_DATABASE_PASSWORD=replace-with-local-random-password
HATCHET_CLIENT_TOKEN=replace-after-creating-a-token-in-hatchet-lite
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
GENERATION_WRITES_ENABLED=true
BUSINESS_DATABASE_API_PASSWORD=replace-with-at-least-20-random-characters
BUSINESS_DATABASE_WORKER_PASSWORD=replace-with-a-different-random-password
BUSINESS_DATABASE_RECOVERY_AUDIT_PASSWORD=replace-with-a-third-random-password
BUSINESS_DATABASE_PROVISION_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
BUSINESS_DATABASE_MIGRATION_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
BUSINESS_DATABASE_OBJECT_OWNER_ROLE=postgres
BUSINESS_DATABASE_URL_API=postgresql://infinite_canvas_api:replace-me@host.docker.internal:54322/postgres
BUSINESS_DATABASE_LISTENER_URL=postgresql://infinite_canvas_api:replace-me@host.docker.internal:54322/postgres
BUSINESS_DATABASE_URL_WORKER=postgresql://infinite_canvas_worker:replace-me@host.docker.internal:54322/postgres
BUSINESS_DATABASE_URL_RECOVERY_AUDIT=postgresql://infinite_canvas_recovery_audit:replace-me@host.docker.internal:54322/postgres
PUBLIC_SUPABASE_URL=http://localhost:54321
INTERNAL_SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace-with-local-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
LOCAL_S3_ACCESS_KEY_ID=replace-with-local-s3-access-key
LOCAL_S3_SECRET_ACCESS_KEY=replace-with-local-s3-secret-key
