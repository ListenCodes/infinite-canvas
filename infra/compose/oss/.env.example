WEB_IMAGE=ghcr.io/listencodes/infinite-canvas-web@sha256:replace-me
API_IMAGE=ghcr.io/listencodes/infinite-canvas-api@sha256:replace-me
WORKER_IMAGE=ghcr.io/listencodes/infinite-canvas-worker@sha256:replace-me
WEB_BIND=127.0.0.1:3000
API_BIND=127.0.0.1:3001
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
GENERATION_WRITES_ENABLED=true
HATCHET_DASHBOARD_BIND=127.0.0.1:8080
HATCHET_DATABASE_PASSWORD=replace-with-long-random-password
HATCHET_PUBLIC_URL=https://hatchet.example.com
HATCHET_COOKIE_DOMAIN=hatchet.example.com
HATCHET_CLIENT_TOKEN=replace-after-running-the-token-command
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_ANON_KEY=replace-with-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-key
BUSINESS_DATABASE_URL_API=postgresql://infinite_canvas_api:replace-me@pooler:5432/postgres?sslmode=require
BUSINESS_DATABASE_LISTENER_URL=postgresql://infinite_canvas_api:replace-me@direct:5432/postgres?sslmode=require
BUSINESS_DATABASE_URL_WORKER=postgresql://infinite_canvas_worker:replace-me@pooler:5432/postgres?sslmode=require
BUSINESS_DATABASE_URL_RECOVERY_AUDIT=postgresql://infinite_canvas_recovery_audit:replace-me@direct:5432/postgres?sslmode=require
BUSINESS_DATABASE_PROVISION_URL=postgresql://role-provisioner:replace-me@direct:5432/postgres?sslmode=require
BUSINESS_DATABASE_MIGRATION_URL=postgresql://migration-owner:replace-me@direct:5432/postgres?sslmode=require
BUSINESS_DATABASE_OBJECT_OWNER_ROLE=migration_owner
BUSINESS_DATABASE_API_PASSWORD=replace-me
BUSINESS_DATABASE_WORKER_PASSWORD=replace-me-different
BUSINESS_DATABASE_RECOVERY_AUDIT_PASSWORD=replace-me-third-secret
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
CORS_ALLOWED_ORIGINS=https://canvas.example.com
API_BASE_URL=https://canvas.example.com/api
S3_REGION=auto
S3_ENDPOINT=https://replace-me.example.com
S3_BUCKET=infinite-canvas-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
